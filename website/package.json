{
  "name": "glowmuse-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsx scripts/prerender.tsx",
    "build:pages": "SITE_BASE=/LumiEdit-Support/ vite build --outDir dist-pages && SITE_BASE=/LumiEdit-Support/ tsx scripts/prerender.tsx dist-pages",
    "sync:pages": "node scripts/sync-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "5.2.8",
    "lucide-react": "0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.131.0"
  }
}
